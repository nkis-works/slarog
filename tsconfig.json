{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": false,
    "strict": true,
    "noEmit": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noPropertyAccessFromIndexSignature": true,
    "useUnknownInCatchVariables": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "types": ["vitest/globals", "node"]
  },
  "include": [
    "playwright.config.ts",
    "playwright.dist.config.ts",
    "playwright.slarog-prototypes.config.ts",
    "tools/slot-analysis/src/**/*.ts",
    "tools/slot-analysis/tests/**/*.ts",
    "tools/slot-analysis/e2e/**/*.ts",
    "tools/slot-analysis/e2e-dist/**/*.ts",
    "prototypes/slarog-home-redesign/**/*.ts"
  ]
}
